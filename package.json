{
  "name": "ar-rafeeq4",
  "version": "4.0.0",
  "private": true,
  "description": "Ar-Rafeeq 4 - offline-first Islamic Android application",
  "scripts": {
    "prepare:web": "node scripts/prepare-android-web.mjs",
    "cap:sync": "npx cap sync android",
    "cap:add:android": "npx cap add android",
    "android:build": "npm run prepare:web && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:prayer": "esbuild scripts/mihrab-algeria-entry.js --bundle --minify --format=iife --target=es2020 --outfile=vendor/mihrab-algeria.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "mihrab-methods": "1.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "esbuild": "0.25.11"
  }
}
